<?xml version="1.0"?>
<package format="3">
  <name>yolo_detector</name>
  <version>0.1.0</version>

  <description>YOLO 2D detector publishing typed ROS interfaces.</description>

  <maintainer email="nguyendangtuyen062004@gmail.com">Nguyen Dang Tuyen</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>cv_bridge</exec_depend>
  <depend>fusion_interfaces</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
