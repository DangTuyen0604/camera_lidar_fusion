<?xml version="1.0"?>
<package format="3">
  <name>fusion_bringup</name>
  <version>0.1.0</version>
  <description>Launch and RViz configuration for the KITTI fusion demo.</description>

  <maintainer email="nguyendangtuyen062004@gmail.com">Nguyen Dang Tuyen</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>perception_core</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>kitti_ros2_player</exec_depend>
  <exec_depend>launch</exec_depend>
