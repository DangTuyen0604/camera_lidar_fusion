Panels:
  - Class: rviz_common/Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: velodyne
    Background Color: 30; 30; 30
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR
      Enabled: true
      Topic:
        Value: /kitti/velodyne/points
    - Class: rviz_default_plugins/Image
      Name: Projection Overlay
      Enabled: true
      Topic:
        Value: /fusion/lidar_overlay
Window Geometry:
  Width: 1280
  Height: 720
