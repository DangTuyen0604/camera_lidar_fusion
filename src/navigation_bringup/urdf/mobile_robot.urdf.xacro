<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fusion_mobile_robot">
  <xacro:include filename="$(find navigation_bringup)/urdf/sensors.xacro"/>
  <xacro:include filename="$(find navigation_bringup)/urdf/gazebo_plugins.xacro"/>

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
  </joint>
  <link name="base_link">
    <visual>
      <geometry><box size="0.55 0.42 0.22"/></geometry>
      <material name="blue"><color rgba="0.1 0.3 0.8 1"/></material>
    </visual>
    <collision><geometry><box size="0.55 0.42 0.22"/></geometry></collision>
    <inertial>
      <mass value="18.0"/>
      <inertia ixx="0.35" ixy="0" ixz="0" iyy="0.48" iyz="0" izz="0.62"/>
    </inertial>
  </link>

  <xacro:sensor_frames parent="base_link"/>
  <xacro:gazebo_materials/>
</robot>
