Panels:
  - Class: rviz_common/Displays
  - Class: rviz_common/Selection
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/Path
      Name: Global Plan
      Enabled: true
      Topic:
        Value: /plan
    - Class: rviz_default_plugins/PointCloud2
      Name: Detection Obstacles
      Enabled: true
      Topic:
        Value: /navigation/detection_obstacles
Window Geometry:
  Width: 1280
  Height: 720
