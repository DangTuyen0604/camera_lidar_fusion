<?xml version="1.0"?>
<package format="3">
  <name>warehouse_mujoco</name><version>0.1.0</version>
  <description>MuJoCo physics, sensors and entity services for the OpenAMRobot warehouse.</description>
  <maintainer email="nguyendangtuyen062004@gmail.com">Nguyen Dang Tuyen</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>ament_index_python</exec_depend><exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend><exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend><exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend><exec_depend>simulation_interfaces</exec_depend>
  <exec_depend>openamrobot_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend><exec_depend>xacro</exec_depend>
  <!-- MuJoCo has no rosdep key on Jazzy: pip install mujoco (see README). -->
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
