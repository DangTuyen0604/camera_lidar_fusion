<!--
  Root MuJoCo scene.  The warehouse geometry is not duplicated here: the
  simulator converts warehouse_simulation/worlds/warehouse.sdf (and its
  model:// includes) into this spec at load time, so the SDF stays the single
  source of truth for the map, the stations and the obstacle layout.
-->
<mujoco model="warehouse_amr">
  <compiler angle="radian" meshdir="../../openamrobot_description/meshes/visual"/>
  <option timestep="0.002" integrator="implicitfast" cone="elliptic"/>
  <!-- MuJoCo scales znear/zfar (and viewer navigation) by the model extent.
       Left automatic, the hidden entity pools (x=100 m, z=-20 m) and the 200 m
       floor plane inflate it to ~126 m, pushing the camera near plane to
       1.3 m: close objects and the floor in front of the robot vanish.  Fix it
       to the 18 x 14 m warehouse. -->
  <statistic extent="20" center="0 0 1"/>

  <visual>
    <global offwidth="1280" offheight="960" azimuth="120" elevation="-35"/>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.5 0.5 0.5" specular="0.1 0.1 0.1"/>
    <quality shadowsize="4096"/>
    <!-- x extent 20: near 0.05 m (the former Gazebo camera clip), far 80 m. -->
    <map znear="0.0025" zfar="4"/>
  </visual>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.55 0.62 0.72"
             rgb2="0.12 0.14 0.18" width="512" height="512"/>
  </asset>

  <worldbody>
    <light name="sun" pos="0 0 10" dir="0 0.2 -1" directional="true" castshadow="true"
           diffuse="0.55 0.55 0.55"/>
    <light name="bay_west" pos="-5 0 5" dir="0 0 -1" diffuse="0.35 0.37 0.42" castshadow="false"/>
    <light name="bay_east" pos="5 0 5" dir="0 0 -1" diffuse="0.35 0.37 0.42" castshadow="false"/>
    <camera name="overview" pos="0 -13 13" xyaxes="1 0 0 0 0.7 0.7" fovy="55"/>
  </worldbody>

  <include file="amr.xml"/>
</mujoco>
