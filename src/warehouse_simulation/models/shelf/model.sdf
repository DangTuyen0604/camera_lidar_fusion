<?xml version="1.0"?>
<sdf version="1.9">
  <model name="shelf">
    <static>true</static>
    <link name="link">
      <!-- One conservative collision envelope: the LiDAR, the Nav2 map and
           physics all use it, whatever the visual detail. -->
      <collision name="collision">
        <pose>0 0 1.2 0 0 0</pose>
        <geometry><box><size>3.0 0.7 2.4</size></box></geometry>
      </collision>
      <!-- Frame: AWS RoboMaker ShelfD (MIT-0), fitted to 3.0 x 0.7 x 2.4 m.
           Decks are at 0.71, 1.29 and 1.86 m. Each crate is its own geom
           (stock_*) so synthetic datasets can label every box. -->
      <visual name="mesh_0"><geometry><mesh><uri>meshes/shelf_0.obj</uri></mesh></geometry><material><pbr><metal><albedo_map>materials/textures/shelf_0.png</albedo_map></metal></pbr></material></visual>
      <visual name="stock_lower_1"><pose>-0.85 0.0 0.935 0 0 0.05</pose><geometry><box><size>0.6 0.5 0.45</size></box></geometry><material><diffuse>0.76 0.55 0.32 1</diffuse><pbr><metal><albedo_map>model://cargo_box/materials/textures/cardboard.png</albedo_map></metal></pbr><texrepeat>1.2 1.2</texrepeat></material></visual>
      <visual name="stock_lower_2"><pose>-0.2 0.02 0.885 0 0 -0.08</pose><geometry><box><size>0.45 0.45 0.35</size></box></geometry><material><diffuse>0.76 0.55 0.32 1</diffuse><pbr><metal><albedo_map>model://cargo_box/materials/textures/cardboard.png</albedo_map></metal></pbr><texrepeat>1.2 1.2</texrepeat></material></visual>
      <visual name="stock_lower_3"><pose>0.75 -0.02 0.960 0 0 0.0</pose><geometry><box><size>0.55 0.5 0.5</size></box></geometry><material><diffuse>0.76 0.55 0.32 1</diffuse><pbr><metal><albedo_map>model://cargo_box/materials/textures/cardboard.png</albedo_map></metal></pbr><texrepeat>1.2 1.2</texrepeat></material></visual>
      <visual name="stock_middle_1"><pose>-0.9 0.0 1.490 0 0 0.0</pose><geometry><box><size>0.5 0.5 0.4</size></box></geometry><material><diffuse>0.76 0.55 0.32 1</diffuse><pbr><metal><albedo_map>model://cargo_box/materials/textures/cardboard.png</albedo_map></metal></pbr><texrepeat>1.2 1.2</texrepeat></material></visual>
      <visual name="stock_middle_2"><pose>0.1 0.01 1.515 0 0 0.1</pose><geometry><box><size>0.6 0.5 0.45</size></box></geometry><material><diffuse>0.76 0.55 0.32 1</diffuse><pbr><metal><albedo_map>model://cargo_box/materials/textures/cardboard.png</albedo_map></metal></pbr><texrepeat>1.2 1.2</texrepeat></material></visual>
      <visual name="stock_upper_1"><pose>-0.5 0.0 2.060 0 0 -0.05</pose><geometry><box><size>0.45 0.45 0.4</size></box></geometry><material><diffuse>0.76 0.55 0.32 1</diffuse><pbr><metal><albedo_map>model://cargo_box/materials/textures/cardboard.png</albedo_map></metal></pbr><texrepeat>1.2 1.2</texrepeat></material></visual>
      <visual name="stock_upper_2"><pose>0.6 0.0 2.010 0 0 0.0</pose><geometry><box><size>0.5 0.45 0.3</size></box></geometry><material><diffuse>0.76 0.55 0.32 1</diffuse><pbr><metal><albedo_map>model://cargo_box/materials/textures/cardboard.png</albedo_map></metal></pbr><texrepeat>1.2 1.2</texrepeat></material></visual>
      <visual name="stock_floor_1"><pose>0.85 0.0 0.250 0 0 0.03</pose><geometry><box><size>0.55 0.5 0.5</size></box></geometry><material><diffuse>0.76 0.55 0.32 1</diffuse><pbr><metal><albedo_map>model://cargo_box/materials/textures/cardboard.png</albedo_map></metal></pbr><texrepeat>1.2 1.2</texrepeat></material></visual>
    </link>
  </model>
</sdf>
