<?xml version="1.0"?>
<sdf version="1.9">
  <model name="shelf">
    <static>true</static>
    <link name="link">
      <!-- Keep one conservative collision envelope so the Gazebo geometry
           continues to match the deterministic Nav2 map. -->
      <collision name="collision">
        <pose>0 0 1.2 0 0 0</pose>
        <geometry><box><size>3.0 0.7 2.4</size></box></geometry>
      </collision>

      <!-- Four uprights. -->
      <visual name="post_front_left">
        <pose>-1.43 -0.29 1.2 0 0 0</pose>
        <geometry><box><size>0.08 0.08 2.4</size></box></geometry>
        <material><diffuse>0.08 0.18 0.32 1</diffuse><pbr><metal><roughness>0.35</roughness></metal></pbr></material>
      </visual>
      <visual name="post_front_right">
        <pose>1.43 -0.29 1.2 0 0 0</pose>
        <geometry><box><size>0.08 0.08 2.4</size></box></geometry>
        <material><diffuse>0.08 0.18 0.32 1</diffuse><pbr><metal><roughness>0.35</roughness></metal></pbr></material>
      </visual>
      <visual name="post_back_left">
        <pose>-1.43 0.29 1.2 0 0 0</pose>
        <geometry><box><size>0.08 0.08 2.4</size></box></geometry>
        <material><diffuse>0.08 0.18 0.32 1</diffuse><pbr><metal><roughness>0.35</roughness></metal></pbr></material>
      </visual>
      <visual name="post_back_right">
        <pose>1.43 0.29 1.2 0 0 0</pose>
        <geometry><box><size>0.08 0.08 2.4</size></box></geometry>
        <material><diffuse>0.08 0.18 0.32 1</diffuse><pbr><metal><roughness>0.35</roughness></metal></pbr></material>
      </visual>

      <!-- Load-bearing shelf decks. -->
      <visual name="deck_bottom">
        <pose>0 0 0.12 0 0 0</pose>
        <geometry><box><size>3.0 0.7 0.10</size></box></geometry>
        <material><diffuse>0.72 0.73 0.75 1</diffuse><pbr><metal><roughness>0.45</roughness></metal></pbr></material>
      </visual>
      <visual name="deck_middle">
        <pose>0 0 0.87 0 0 0</pose>
        <geometry><box><size>3.0 0.7 0.10</size></box></geometry>
        <material><diffuse>0.72 0.73 0.75 1</diffuse><pbr><metal><roughness>0.45</roughness></metal></pbr></material>
      </visual>
      <visual name="deck_top">
        <pose>0 0 1.62 0 0 0</pose>
        <geometry><box><size>3.0 0.7 0.10</size></box></geometry>
        <material><diffuse>0.72 0.73 0.75 1</diffuse><pbr><metal><roughness>0.45</roughness></metal></pbr></material>
      </visual>
      <visual name="top_beam">
        <pose>0 0 2.34 0 0 0</pose>
        <geometry><box><size>3.0 0.10 0.12</size></box></geometry>
        <material><diffuse>0.08 0.18 0.32 1</diffuse><pbr><metal><roughness>0.35</roughness></metal></pbr></material>
      </visual>

      <!-- Non-orange stock makes the warehouse look occupied without
           confusing the simulation color detector. -->
      <visual name="stock_blue_lower">
        <pose>-0.85 0 0.48 0 0 0</pose>
        <geometry><box><size>0.55 0.52 0.60</size></box></geometry>
        <material><diffuse>0.12 0.38 0.72 1</diffuse></material>
      </visual>
      <visual name="stock_green_lower">
        <pose>0.05 0 0.43 0 0 0</pose>
        <geometry><box><size>0.70 0.52 0.50</size></box></geometry>
        <material><diffuse>0.14 0.48 0.31 1</diffuse></material>
      </visual>
      <visual name="stock_grey_upper">
        <pose>0.85 0 1.22 0 0 0</pose>
        <geometry><box><size>0.65 0.50 0.58</size></box></geometry>
        <material><diffuse>0.46 0.49 0.54 1</diffuse></material>
      </visual>
      <visual name="stock_blue_upper">
        <pose>-0.25 0 1.28 0 0 0</pose>
        <geometry><box><size>0.78 0.50 0.68</size></box></geometry>
        <material><diffuse>0.18 0.34 0.62 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
