<?xml version="1.0"?>
<sdf version="1.9">
  <model name="worker_standing">
    <static>true</static>
    <link name="link">
      <collision name="collision"><pose>0 0 0.9 0 0 0</pose><geometry><cylinder><radius>0.30</radius><length>1.8</length></cylinder></geometry></collision>
      <!-- Gazebo Fuel OpenRobotics person (CC0), hi-vis orange clothing (hi_vis_*). -->
      <visual name="mesh_0"><geometry><mesh><uri>meshes/worker_standing_0.obj</uri></mesh></geometry><material><pbr><metal><albedo_map>materials/textures/worker_standing_0.png</albedo_map></metal></pbr></material></visual>
      <visual name="hi_vis_trousers"><geometry><mesh><uri>meshes/worker_standing_1.obj</uri></mesh></geometry><material><pbr><metal><albedo_map>materials/textures/worker_standing_1.png</albedo_map></metal></pbr></material></visual>
      <visual name="hi_vis_top"><geometry><mesh><uri>meshes/worker_standing_2.obj</uri></mesh></geometry><material><pbr><metal><albedo_map>materials/textures/worker_standing_2.png</albedo_map></metal></pbr></material></visual>
      <visual name="mesh_3"><geometry><mesh><uri>meshes/worker_standing_3.obj</uri></mesh></geometry><material><pbr><metal><albedo_map>materials/textures/worker_standing_3.png</albedo_map></metal></pbr></material></visual>
      <visual name="mesh_4"><geometry><mesh><uri>meshes/worker_standing_4.obj</uri></mesh></geometry><material><pbr><metal><albedo_map>materials/textures/worker_standing_4.png</albedo_map></metal></pbr></material></visual>
      <visual name="mesh_5"><geometry><mesh><uri>meshes/worker_standing_5.obj</uri></mesh></geometry><material><pbr><metal><albedo_map>materials/textures/worker_standing_5.png</albedo_map></metal></pbr></material></visual>
      <visual name="mesh_6"><geometry><mesh><uri>meshes/worker_standing_6.obj</uri></mesh></geometry><material><pbr><metal><albedo_map>materials/textures/worker_standing_6.png</albedo_map></metal></pbr></material></visual>
    </link>
  </model>
</sdf>
