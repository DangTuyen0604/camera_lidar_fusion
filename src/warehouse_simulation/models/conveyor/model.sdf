<?xml version="1.0"?>
<sdf version="1.9">
  <model name="conveyor">
    <static>true</static>
    <link name="link">
      <!-- Legs plus the raised belt frame, not one solid block: the LiDAR
           ray-casts collisions, and at its scan height (~0.45 m) a real
           conveyor only shows its legs.  The map still projects the full
           3.0 x 0.8 m footprint because the belt frame covers it. -->
      <collision name="collision_belt">
        <pose>0 0 0.82 0 0 0</pose>
        <geometry><box><size>3.0 0.8 0.36</size></box></geometry>
      </collision>
      <collision name="collision_leg_1"><pose>-1.2 -0.28 0.38 0 0 0</pose><geometry><box><size>0.12 0.12 0.76</size></box></geometry></collision>
      <collision name="collision_leg_2"><pose>-1.2 0.28 0.38 0 0 0</pose><geometry><box><size>0.12 0.12 0.76</size></box></geometry></collision>
      <collision name="collision_leg_3"><pose>1.2 -0.28 0.38 0 0 0</pose><geometry><box><size>0.12 0.12 0.76</size></box></geometry></collision>
      <collision name="collision_leg_4"><pose>1.2 0.28 0.38 0 0 0</pose><geometry><box><size>0.12 0.12 0.76</size></box></geometry></collision>
      <visual name="belt">
        <pose>0 0 0.92 0 0 0</pose>
        <geometry><box><size>2.85 0.68 0.10</size></box></geometry>
        <material><diffuse>0.055 0.065 0.075 1</diffuse><pbr><metal><roughness>0.75</roughness></metal></pbr></material>
      </visual>
      <visual name="left_frame"><pose>0 -0.36 0.79 0 0 0</pose><geometry><box><size>3.0 0.08 0.30</size></box></geometry><material><diffuse>0.18 0.22 0.27 1</diffuse><pbr><metal><roughness>0.35</roughness></metal></pbr></material></visual>
      <visual name="right_frame"><pose>0 0.36 0.79 0 0 0</pose><geometry><box><size>3.0 0.08 0.30</size></box></geometry><material><diffuse>0.18 0.22 0.27 1</diffuse><pbr><metal><roughness>0.35</roughness></metal></pbr></material></visual>
      <visual name="leg_1"><pose>-1.20 -0.28 0.38 0 0 0</pose><geometry><box><size>0.12 0.12 0.76</size></box></geometry><material><diffuse>0.48 0.52 0.57 1</diffuse></material></visual>
      <visual name="leg_2"><pose>-1.20 0.28 0.38 0 0 0</pose><geometry><box><size>0.12 0.12 0.76</size></box></geometry><material><diffuse>0.48 0.52 0.57 1</diffuse></material></visual>
      <visual name="leg_3"><pose>1.20 -0.28 0.38 0 0 0</pose><geometry><box><size>0.12 0.12 0.76</size></box></geometry><material><diffuse>0.48 0.52 0.57 1</diffuse></material></visual>
      <visual name="leg_4"><pose>1.20 0.28 0.38 0 0 0</pose><geometry><box><size>0.12 0.12 0.76</size></box></geometry><material><diffuse>0.48 0.52 0.57 1</diffuse></material></visual>
      <visual name="roller_1"><pose>-1.1 0 0.98 1.5708 0 0</pose><geometry><cylinder><radius>0.07</radius><length>0.68</length></cylinder></geometry><material><diffuse>0.55 0.58 0.62 1</diffuse><pbr><metal><roughness>0.25</roughness></metal></pbr></material></visual>
      <visual name="roller_2"><pose>-0.55 0 0.98 1.5708 0 0</pose><geometry><cylinder><radius>0.07</radius><length>0.68</length></cylinder></geometry><material><diffuse>0.55 0.58 0.62 1</diffuse><pbr><metal><roughness>0.25</roughness></metal></pbr></material></visual>
      <visual name="roller_3"><pose>0 0 0.98 1.5708 0 0</pose><geometry><cylinder><radius>0.07</radius><length>0.68</length></cylinder></geometry><material><diffuse>0.55 0.58 0.62 1</diffuse><pbr><metal><roughness>0.25</roughness></metal></pbr></material></visual>
      <visual name="roller_4"><pose>0.55 0 0.98 1.5708 0 0</pose><geometry><cylinder><radius>0.07</radius><length>0.68</length></cylinder></geometry><material><diffuse>0.55 0.58 0.62 1</diffuse><pbr><metal><roughness>0.25</roughness></metal></pbr></material></visual>
      <visual name="roller_5"><pose>1.1 0 0.98 1.5708 0 0</pose><geometry><cylinder><radius>0.07</radius><length>0.68</length></cylinder></geometry><material><diffuse>0.55 0.58 0.62 1</diffuse><pbr><metal><roughness>0.25</roughness></metal></pbr></material></visual>
    </link>
  </model>
</sdf>
